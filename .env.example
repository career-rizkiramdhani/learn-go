# Example environment variables for the application

# Database: you can either set a full DATABASE_URL (Postgres DSN)
# e.g. DATABASE_URL="host=localhost user=postgres password=secret dbname=mydb port=5432 sslmode=disable"
DATABASE_URL=

# Or set components (used when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yourdbname
POSTGRES_SSLMODE=disable

# JWT secret used to sign tokens (change in production)
JWT_SECRET=supersecretkey

# Server port
PORT=8080

# TLS (optional) - if you want to serve HTTPS directly from the app
# set USE_TLS=true and point CERT_FILE/KEY_FILE to your certificate and key
USE_TLS=false
CERT_FILE=cert.pem
KEY_FILE=key.pem
